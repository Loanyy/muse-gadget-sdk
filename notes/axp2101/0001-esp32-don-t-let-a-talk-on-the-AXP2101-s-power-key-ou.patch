+#define ESP_RETURN_ON_FALSE(a, err_code, log_tag, format, ...) do { \
+        if (!(a)) {                                                 \
+            ESP_LOGE(log_tag, format, ##__VA_ARGS__);               \
+            return err_code;                                        \
+        }                                                           \

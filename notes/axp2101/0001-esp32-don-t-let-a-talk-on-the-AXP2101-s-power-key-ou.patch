+/* As IDF's: log and return the error, or return err_code if a is false. */
+#define ESP_RETURN_ON_ERROR(x, log_tag, format, ...) do {        \
+        esp_err_t err_rc_ = (x);                                 \
+        if (err_rc_ != ESP_OK) {                                 \
+            ESP_LOGE(log_tag, format, ##__VA_ARGS__);            \
+            return err_rc_;                                      \
+        }                                                        \
+    } while (0)
